PORT=3000
HOST=0.0.0.0
BASE_URL=
# Edit DATABASE_URL to match a local Postgres role/password/database that already exists.
# `npm run db:bootstrap` creates tables in that database; it does not create the role or database itself.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fabric
ADMIN_KEY=local-dev-admin-key
DEFAULT_RATE_LIMIT_LIMIT=1000
SEARCH_CREDIT_COST=5
SIGNUP_GRANT_CREDITS=500
EMAIL_PROVIDER=stub
EMAIL_FROM=noreply@fabric.local
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RECOVERY_CHALLENGE_TTL_MINUTES=10
RECOVERY_CHALLENGE_MAX_ATTEMPTS=5
RATE_LIMIT_RECOVERY_START_PER_HOUR=20
RATE_LIMIT_RECOVERY_START_PER_NODE_PER_HOUR=5
RATE_LIMIT_EMAIL_VERIFY_START_PER_HOUR=10

STRIPE_WEBHOOK_SECRET=whsec_change_me
OPS_DIGEST_EMAIL=
