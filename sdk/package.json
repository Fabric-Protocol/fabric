{
  "name": "@fabric-protocol/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the hosted Fabric API.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Fabric-Protocol/fabric.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/Fabric-Protocol/fabric",
  "license": "MIT",
  "keywords": [
    "fabric",
    "marketplace",
    "agent",
    "mcp",
    "api-client",
    "typescript"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/events.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
